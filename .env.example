# Copy to .env and fill in. Never commit .env. On the VPS this file lives only on the server.

INWARD_ENV=dev                      # dev | prod
DJANGO_SECRET_KEY=                  # required in prod: a long random string
INWARD_ALLOWED_HOSTS=localhost,127.0.0.1   # prod: inward.rainbowlogistics.co.in

# PostgreSQL (created by scripts/setup_database.ps1 locally; by Docker Compose on the VPS)
INWARD_DATABASE_URL=postgresql+psycopg://inward_app:CHANGE_ME@localhost:5432/inward
INWARD_TEST_DATABASE_NAME=inward_test

# Documents (outside any synced folder; mirrored to OneDrive by the worker)
INWARD_DOCUMENT_ROOT=D:/InwardData/documents

INWARD_DEPOT_CODE=035
INWARD_ADMIN_URL=control-035/        # non-default address of the masters / users admin area

# Gmail mail engine: dedicated account with 2-Step Verification + an App Password
INWARD_GMAIL_ADDRESS=
INWARD_GMAIL_APP_PASSWORD=
INWARD_SIT_SUBJECT=BPIL Depot Stock In Transit Report
INWARD_MAIL_CONFIRM_TIMEOUT_MIN=30
INWARD_MESSAGE_ID_DOMAIN=inward.rainbowlogistics.co.in
